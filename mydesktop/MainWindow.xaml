<Window x:Class="mydesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Desktop"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="Black">

    <Grid Margin="60,160,60,240">

        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- TOP INFORMATION -->

        <Grid Grid.Row="0" Margin="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- DATE -->
            <Border Grid.Column="0"
                    Margin="5"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    Opacity="0.8">


                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="DateText"
                               Foreground="White"
                               FontSize="22"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="DayText"
                               Foreground="#888888"
                               FontSize="15"
                               FontFamily="Consolas"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>


            <!-- CLOCK -->
            <Border Grid.Column="1"
                    Margin="5"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    Opacity="0.8">

                <TextBlock x:Name="ClockText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="42"
                           FontFamily="Consolas"/>

            </Border>


            <!-- WEATHER -->
            <Border Grid.Column="2"
                    Margin="5"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    Opacity="0.8">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="WeatherText"
                               Text="☀ 25°C"
                               Foreground="White"
                               FontSize="22"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Gandhinagar"
                               Foreground="#888888"
                               FontSize="15"
                               FontFamily="Consolas"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- EMPTY MIDDLE -->

        <Grid Grid.Row="1"/>


        <!-- COMMAND LINE -->

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- OUTPUT / HELP AREA -->

            <TextBox x:Name="OutputText"
                     Grid.Row="0"
                     Background="Black"
                     Foreground="White"
                     BorderThickness="0"
                     BorderBrush="Transparent"
                     FontFamily="Consolas"
                     FontSize="18"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="10,-215,10,15"
                     Padding="6"/>

            <TextBox x:Name="CommandBox"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     CaretBrush="White"
                     FontFamily="Consolas"
                     FontSize="28"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Padding="10"
                     Text="> "
                     KeyDown="CommandBox_KeyDown"/>

        </Grid>

    </Grid>

</Window>